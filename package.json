{
  "name": "dsh-panel-pins",
  "version": "1.4.5",
  "type": "module",
  "description": "DeepSeek Harness 侧栏面板键盘启动器：Ctrl+K 一键直达任何面板，可搜索分组菜单 + 命中高亮 + Alt+1..9 直达 + 最近使用，配钉住/置顶/拖拽排序/隐藏/重命名/具名布局预设/仅图标/紧凑底部区，并把只注册了设置页的第三方插件桥接进菜单。只改显示层，卸载零残留，兼容 DSH ≥0.2.0-rc.1。 A keyboard-first sidebar panel launcher for DeepSeek Harness: Ctrl+K palette, searchable grouped Panels menu, Alt+1..9 jumps, MRU, pin/top/hide/rename, drag-to-reorder, named layout presets, settings-page bridging, export/import.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "sidebar-panel",
    "panels",
    "panel-manager",
    "launcher",
    "command-palette",
    "pin",
    "rename",
    "layout-presets",
    "侧栏",
    "面板管理"
  ],
  "license": "MIT",
  "author": "QDNBD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QDNBD/dsh-panel-pins.git"
  },
  "homepage": "https://github.com/QDNBD/dsh-panel-pins#readme",
  "bugs": "https://github.com/QDNBD/dsh-panel-pins/issues",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/client.js",
    "lib/index.js",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
